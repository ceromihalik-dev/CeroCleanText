<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CeroCleanText</AssemblyName>
    <RootNamespace>CeroCleanText</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>CeroCleanText</Product>
    <Description>Lightweight Windows text cleaner for hidden Unicode characters and unwanted formatting.</Description>
    <Company>C. Mihalik</Company>
    <Authors>C. Mihalik</Authors>
    <Copyright>Copyright © 2026 C. Mihalik</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CeroCleanText.Core/CeroCleanText.Core.csproj" />
  </ItemGroup>
</Project>
